---
source: crates/agent/tests/tool_schemas.rs
expression: tool.parameters()
---
{
  "$defs": {
    "Content": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ContentItem"
          },
          "type": "array"
        },
        "v": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "v",
        "items"
      ],
      "type": "object"
    },
    "ContentItem": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "metric": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "$ref": "#/$defs/ValueType"
        },
        "uncertain": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": true
      },
      "required": [
        "key",
        "type",
        "label",
        "value"
      ],
      "type": "object"
    },
    "ValueType": {
      "enum": [
        "text",
        "number",
        "date",
        "image",
        "single_select",
        "multi_select",
        "table"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content": {
      "$ref": "#/$defs/Content"
    },
    "event_date": {
      "format": "date",
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "subject_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "type": "array"
    },
    "template_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "content"
  ],
  "title": "CreateDocument",
  "type": "object"
}
