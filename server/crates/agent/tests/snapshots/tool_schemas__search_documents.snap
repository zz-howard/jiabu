---
source: crates/agent/tests/tool_schemas.rs
expression: tool.parameters()
---
{
  "$defs": {
    "DocumentFilters": {
      "additionalProperties": false,
      "properties": {
        "created_by_member_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "format": "date",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Status"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "template_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "format": "date",
          "type": [
            "string",
            "null"
          ]
        },
        "unassociated": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 50,
          "format": "uint32",
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Status": {
      "enum": [
        "active",
        "voided"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "filters": {
      "$ref": "#/$defs/DocumentFilters",
      "default": {
        "created_by_member_id": null,
        "from": null,
        "status": null,
        "subject_id": null,
        "template_id": null,
        "to": null,
        "unassociated": false
      }
    },
    "page": {
      "$ref": "#/$defs/Page",
      "default": {
        "limit": 50,
        "offset": 0
      }
    }
  },
  "title": "SearchDocuments",
  "type": "object"
}
