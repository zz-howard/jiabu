      "maxLength": 30,
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "opening_balance_minor": {
      "format": "int64",
      "maximum": 1000000000000,
      "minimum": -1000000000000,
      "type": [
        "integer",
        "null"
      ]
    },
    "opening_on": {
      "format": "date",
      "type": [
        "string",
        "null"
      ]
    },
    "sort_key": {
      "format": "int32",
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
