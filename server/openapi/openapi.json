{
  "components": {
    "schemas": {
      "MetaResponse": {
        "properties": {
          "api_versions": {
            "items": {
              "format": "int32",
              "type": "integer"
            },
            "type": "array"
          },
          "server_version": {
            "type": "string"
          }
        },
        "required": [
          "server_version",
          "api_versions"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Jiabu public API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    },
    "/v1/meta": {
      "get": {
        "operationId": "get_public_meta",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "api_versions": [
                    1
                  ],
                  "server_version": "0.1.0"
                },
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            },
            "description": "Server and API versions"
          }
        }
      }
    }
  }
}
